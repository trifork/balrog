{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node", "vite/client"]
  },
  "references": [],
  "include": ["plugin/**/*.ts", "server/**/*.ts", "tests/**/*.ts", "shared/**/*.ts", "frontend/**/*.ts", "frontend/**/*.tsx"]
}
